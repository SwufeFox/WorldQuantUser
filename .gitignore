.alma-snapshots/
__pycache__/
*.py[cod]

# credentials and session material -- must never be committed
.env
.env.*
!.env.example
.brain_session.json
brain_session.json
*.session.json
.brain_checkpoints/

# Research output is not versioned here: this repository holds the tool only.
# Results (simulation JSON, field-catalog snapshots, the alpha registry, the
# learned operator denylist) live in $BRAIN_RESEARCH_DIR, which defaults to
# ~/.local/share/worldquant-research. This rule is a guard rail so a stray run
# inside the working tree cannot silently add data to the repo.
research/
research/*-checkpoint.json
research/*.checkpoint.json
*-checkpoint.json
