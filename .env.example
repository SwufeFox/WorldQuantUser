# Copy this file to .env and fill in the values you use.
# .env is git-ignored; never commit real credentials.
#
# The module loads this file once, on first use. Real environment variables take
# precedence over values defined here.

# WorldQuant BRAIN login (required for simulate/auth/catalog/alpha).
BRAIN_USERNAME=
BRAIN_PASSWORD=

# DeepSeek API key (optional). Enables `search` / `search --fetch`, which is how
# a mechanism idea gets connected to the paper that tests it. Only the key is
# needed; the endpoint is https://api.deepseek.com/v1/tools/search.
# Search and Fetch are free of charge until billing starts on 2026-11-01
# Beijing time. Create a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
