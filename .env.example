# Copy this file to .env and fill in the values you use.
#
# .env must sit next to machine_lib.py (the repository root). The loader resolves it
# relative to the module, not to the current directory, so running the CLI from elsewhere
# still finds it - and a .env in some other directory is silently ignored.
# .env is git-ignored; never commit real credentials.
#
# Real environment variables always win over this file, so a shell or CI setting is never
# silently overridden. The file is read once per process.
#
# Verify what the tool actually sees:
#   python research_cli.py auth check          # credentials and account scope
#   python research_cli.py schema              # resolved research directory, env names


# --- Submission lock (required, defaults to closed) -----------------------

# Real submissions are REFUSED unless this is exactly `true`. While it is unset, empty or
# `false`, the CLI will still backtest, run the platform's checks and analyse
# self-correlation - it just will not take the one irreversible action, which is the POST to
# /alphas/{id}/submit.
#
# Submission cannot be undone from this side, and an agent that can take it eventually will,
# at a time nobody chose. Flipping this to `true` is how the account holder says "now".
# Every other spelling (1, yes, TRUE, on) keeps it closed.
ALLOW_AGENT_SUBMIT=false


# --- Required -------------------------------------------------------------
# WorldQuant BRAIN login. Needed by every command that talks to the platform:
# simulate, resume, catalog, alpha, lint against the live catalogue.
BRAIN_USERNAME=
BRAIN_PASSWORD=


# --- Where results go (optional) -----------------------------------------
# Simulation results, the alpha ledger, field-catalogue snapshots and the learned
# operator denylist all live OUTSIDE the repository, in the directory this resolves to.
# Default: <persistent workspace>/worldquant-research, falling back to
# $XDG_DATA_HOME/worldquant-research and then ~/.local/share/worldquant-research.
#
# Set it explicitly if that default lands somewhere ephemeral - a ledger in a container
# layer is no better than one never written. Back this directory up; it is the durable
# memory of the research.
# BRAIN_RESEARCH_DIR=/data/worldquant-research


# --- Literature search (optional) ----------------------------------------
# Enables `search` and `search --fetch`, which is how a mechanism idea gets connected to
# the paper that tests it. Only the key is needed; the endpoint is
# https://api.deepseek.com/v1/tools/search. Create a key at
# https://platform.deepseek.com/api_keys
# Pricing is set by DeepSeek and changes; check their pricing page rather than trusting a
# date written here.
DEEPSEEK_API_KEY=

# Alias accepted by the code because other tools on the same machine export this name.
# Use whichever you already have; DEEPSEEK_API_KEY is checked first.
# WEBSEARCH_API_KEY=


# --- Platform tuning (optional) ------------------------------------------
# Seconds the login lock is held while authenticating. Raise it if two processes start at
# once and the second re-authenticates straight into a captcha.
# BRAIN_LOGIN_LOCK_TIMEOUT=60

# How long the cached operator/field/dataset catalogue is trusted, in seconds.
# 0 disables caching, which costs a request per command and can trip rate limits.
# BRAIN_METADATA_TTL=86400